act-router-dom\";\nimport './Navbar.css';\nimport { useTheme } from '../../../context/ThemeContext/ThemeContext';\n\nconst Navbar = ({ isPreloaderDone }) => {\n    const navigate = useNavigate();\n    const location = useLocation();\n    const [isOpen, setIsOpen] = useState(false);\n    const [isAcademicsOpen, setIsAcademicsOpen] = useState(false);\n    const [scrolled, setScrolled] = useState(false);\n\n    const timeoutRef = useRef(null);\n    const { isDarkTheme, toggleTheme } = useTheme();\n\n    // 🚨 Shrinking Scroll Effect\n    useEffect(() => {\n        const handleScroll = () => {\n            const isScrolled = window.scrollY > 30;\n            if (isScrolled !== scrolled) {\n                setScrolled(isScrolled);\n            }\n        };\n\n        window.addEventListener(\"scroll\", handleScroll, { passive: true });\n        return () => window.removeEventListener(\"scroll\", handleScroll);\n    }, [scrolled]);\n\n    const handleMouseEnter = () => {\n        if (timeoutRef.current) clearTimeout(timeoutRef.current);\n        setIsAcademicsOpen(true);\n    };\n\n    const handleMouseLeave = () => {\n        timeoutRef.current = setTimeout(() => {\n            setIsAcademicsOpen(false);\n        }, 200);\n    };\n\n    const handleNavigation = (path, sectionId) => {\n        setIsOpen(false);\n\n        if (path === \"/\") {\n            if (location.pathname !== \"/\") {\n                navigate(\"/\");\n                setTimeout(() => scrollToSection(sectionId), 100);\n            } else {\n                scrollToSection(sectionId);\n            }\n        } else {\n            navigate(path);\n        }\n    };\n\n    const scrollToSection = (id) => {\n        const element = document.getElementById(id);\n        if (element) {\n            const navbarHeight = 80; // Offset for the shrunken navbar\n            const elementPosition = element.getBoundingClientRect().top + window.scrollY;\n            window.scrollTo({\n                top: elementPosition - navbarHeight,\n                behavior: \"smooth\"\n            });\n        } else {\n            window.scrollTo({ top: 0, behavior: \"smooth\" });\n        }\n    };\n\n    return (\n        <nav className={`navbar ${isDarkTheme ? \"dark-theme\" : \"light-theme\"} ${scrolled ? \"scrolled\" : \"\"}`}>\n            <div className=\"navbar-container\">\n                <div className=\"navbar-content\">\n\n                    {/* --- LEFT MENU (Desktop) / HAMBURGER (Mobile) --- */}\n                    <div className=\"nav-left\">\n                        <div className=\"desktop-menu\">\n                            <button className=\"nav-link\" onClick={() => navigate(\"/legacy\")}>Legacy</button>\n                            <button className=\"nav-link\" onClick={() => handleNavigation(\"/\", \"practice\")}>Practice Areas</button>\n                            <button className=\"nav-link\" onClick={() => handleNavigation(\"/\", \"people\")}>Our People</button>\n                        </div>\n                        <button onClick={() => setIsOpen(!isOpen)} className=\"icon-btn mobile-toggle\" aria-label=\"Toggle Menu\">\n                            {isOpen ? <X size={26} /> : <Menu size={26} />}\n                        </button>\n                    </div>\n\n                    {/* --- CENTER: THE NEW JSM SIGNATURE LOGO --- */}\n                    <div className={`navbar-brand ${!isPreloaderDone ? 'logo-hidden' : ''}`} onClick={() => handleNavigation(\"/\", \"home\")}>\n                        <svg className=\"jsm-nav-logo\" version=\"1.1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 672\">\n                            <path d=\"M159.606796,473.791565 C170.728668,454.018402 185.974594,438.122925 202.336441,423.388916 C263.158051,368.618134 332.281616,327.186127 408.137329,296.832123 C443.347992,282.742432 479.593323,272.291443 517.309875,267.424652 C520.357483,267.031433 522.482788,265.821930 523.992371,263.011230 C526.351013,258.619